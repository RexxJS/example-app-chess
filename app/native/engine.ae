const MATE_VALUE = 20000
const BISHOP_PAIR_VALUE = 50
const PHASE_MAX = 24
const PHASE_WEIGHTS: int[] = [0, 1, 1, 2, 4, 0]
const INF = 1000000

// Per piece a value per square, a8 first, read at index ^ 56 for white (ai.ts's PIECE_SQUARE_TABLES), one flat table.
const PST: int[] = [
