// app/native/engine.ae: the computer player in Aether (TODO.md 4.4), a port
// of app/chess/ai.ts and the parts of position.ts, move.ts, zobrist.ts and
// bitboard.ts it stands on, from Kaj Björklund's JavaScript Chess
// (https://github.com/kbjorklu/chess, MIT, copyright (c) 2013 Kaj
// Björklund; LICENSE) as this repository carried it over to TypeScript.
//
// The TypeScript engine is the reference: this one makes the same moves
// in the same order, hashes positions with the same Zobrist table, orders
// and searches them the same way, keeps the same transposition table
// (cleared at the same size), evaluates them alike and chooses among equal
// moves by the same mix of the hash and the seed, so for a position and a
// depth both give the same move, value, depth, ties, nodes and positions
// evaluated (tests/native/check.sh holds them to it). Bitboards are one
// uint64 here, not two 32-bit halves.
//
// A module (TODO.md 4.4): what the page calls, through sae's natives
// (app.json "natives", sae's docs/natives.md), and what native/cli.ae runs
// as a program. It needs no capability at all (`ae inspect` says
// "capability-empty"): no files, no clock, no system, no C; sae holds a
// native module to that. Its two functions, a string in and a string out:
//
//   search("<depth>|<seed>|<fen>|<moves>")    the moves (coordinate, from the
//     FEN, space-separated, maybe none) played first, so the search knows
//     the game's repetitions as ai.ts's does from game.positionCopy();
//     gives "best=e2e4 value=35 reached=4 ties=1 nodes=2338 evaluations=1675"
//   perft("<depth>|<fen>")                    gives "nodes=197281"
//
// Chess960 (TODO.md 6.5) as position.ts has it: the castling rooks the
// position's own, a castling move the king on to its rook.

import std.string

exports (search, perft)

// ---- pieces, colours, moves

const PAWN = 0
const KNIGHT = 1
const BISHOP = 2
const ROOK = 3
const QUEEN = 4
const KING = 5
const WHITE = 0
const BLACK = 1
const NONE = -1

const K_POSITIONAL = 0
const K_DOUBLE_PAWN_PUSH = 1
const K_KING_CASTLE = 2
const K_QUEEN_CASTLE = 3
const K_CAPTURE = 4
const K_EN_PASSANT = 5
const K_KNIGHT_PROMOTION = 8
const K_QUEEN_PROMOTION = 11
const K_KNIGHT_PROMOTION_CAPTURE = 12
const K_QUEEN_PROMOTION_CAPTURE = 15

// A move as move.ts packs it: to | from << 6 | kind << 12 | piece << 16 | captured << 19.
mv(from: int, to: int, kind: int, piece: int, captured: int) -> int {
    c = captured
    if c < 0 { c = 0 }
    return (to & 63) | ((from & 63) << 6) | ((kind & 15) << 12) | ((piece & 7) << 16) | ((c & 7) << 19)
}
m_to(m: int) -> int { return m & 63 }
m_from(m: int) -> int { return (m >> 6) & 63 }
m_kind(m: int) -> int { return (m >> 12) & 15 }
m_piece(m: int) -> int { return (m >> 16) & 7 }
m_captured(m: int) -> int { return (m >> 19) & 7 }
m_is_capture(m: int) -> int { return (m_kind(m) >> 2) & 1 }
m_is_promotion(m: int) -> int { return (m_kind(m) >> 3) & 1 }
m_is_castle(m: int) -> int {
    k = m_kind(m)
    if k == K_KING_CASTLE || k == K_QUEEN_CASTLE { return 1 }
    return 0
}
m_promoted(m: int) -> int {
    if m_is_promotion(m) == 1 { return KNIGHT + (m_kind(m) & 3) }
    return PAWN
}
m_capture_square(m: int) -> int {
    if m_kind(m) != K_EN_PASSANT { return m_to(m) }
    if m_from(m) < m_to(m) { return m_to(m) - 8 }
    return m_to(m) + 8
}

const FILES_CH = "abcdefgh"
const RANKS_CH = "12345678"
const PROMO_CH = " nbrqk"

square_name(i: int) -> string {
    return string.concat(string.substring(FILES_CH, i & 7, (i & 7) + 1), string.substring(RANKS_CH, i >> 3, (i >> 3) + 1))
}

// "e2e4", "e7e8q", as Move.getCoordinate.
coordinate(m: int) -> string {
    s = string.concat(square_name(m_from(m)), square_name(m_to(m)))
    if m_is_promotion(m) == 1 {
        p = m_promoted(m)
        s = string.concat(s, string.substring(PROMO_CH, p, p + 1))
    }
    return s
}

// ---- the evaluation's numbers (ai.ts)

