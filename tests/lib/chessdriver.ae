// chessdriver.ae — verbs for the chess app's specs (app/chess.ts), on
// saedriver and aether-ui's uidriver. Grows with the page: the board, the
// move list and the buttons each get their verbs as TODO.md's stage 3 lands.

exports(wait_ready, wait_moves, wait_fen)

import saedriver as b

// The page is up: its title text is shown. 1 when it is, 0 after the wait.
wait_ready() -> int { return b.wait_for_text("Chess") }

// The page's move list reads `sans` ("e4 e5 Nf3"; "" for none yet).
wait_moves(sans: string) -> int {
    if sans == "" { return b.wait_for_text("Moves: none yet") }
    return b.wait_for_text("Moves: ${sans}")
}

// The page shows the position `fen`.
wait_fen(fen: string) -> int { return b.wait_for_text("FEN: ${fen}") }
